[7.5, "o", "\u001b[2J\u001b[H\r\n                                     ORIFUDE\r\n\r\n\r\n          \u28b0 \u2880\u28e0\u283e\u281b\u281b\u2841\u00b7 \u28e0\u2836\u280b\u00b7  \u28e7\u281e\u00b7 \u28a0\u2806 \u2880\u00b7\r\n  \u28e4\u28e4\u28e4\u28c0\u28c0\u28c0\u2864\u2834\u283a\u280b\u2801\u2801  \u28e0\u2867\u2816\u281b\u2801  \u28f8\u2834\u280b\u2818  \u2870\u2803\u28e0\u28b4\u280f \u28a0\u281e        \u2880\r\n    \u2809\u2809\u2819\u281b\u283b\u2837\u28f6\u28e4\u28f4\u28d2\u281a\u2809\u2809  \u28c0\u2860\u2816\u280b\u2819    \u28c0\u2834\u280a\u2821\u280b \u2810\u2801   \u2874 \u2880\u281e\u2880\u2874\u280b\r\n           \u2819\u28af\u2859\u283b\u2837\u28f6\u28f6\u28cb\u2841    \u28c0\u2864\u2816\u280b\u2801       \u2880\u28c0\u287e\u2824\u2834\u281b\u281a\u2809\u2801\u00b7\r\n            \u28a0\u281b\u28a6 \u2808\u283b\u28cd\u281b\u283f\u28b6\u28f6\u28cd\u28c1\u2840    \u28c0\u28e0\u2824\u2816\u2812\u2809\u2809           \u256d Home \u00b7 Journey 0/40 \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\r\n           \u2820\u2803  \u2873\u2844 \u2808\u2833\u2840 \u2808\u28af\u2859\u283b\u283f\u28b6\u28ee\u284d\u2801                 \u2502 \u203a Continue the journey     \u2502\r\n              \u28f0\u2803\u2818\u28c6  \u2819\u28c6  \u2819\u28a6\u2840 \u2819\u283b\u28b6\u28e6\u28c4\u28c0              \u2502   Today's paper            \u2502\r\n              \u2801 \u2880\u284e\u28a6 \u28b8\u2819\u28c6\u2840  \u2819\u28a6\u2840  \u2808\u2819\u28ba\u282d\u28d2\u2866\u28a4\u28c0         \u2502   Endless garden           \u2502\r\n                \u281e \u2808\u00b7\u2803 \u28f8\u2847    \u285d\u28a6\u2840  \u284f  \u2809\u2855\u2832\u282d\u2884\u28c0\u2840     \u2502   Puzzle packs             \u2502\r\n                  \u2880\u284e \u2830\u2803\u2838\u2844\u2844 \u2878  \u2819\u28e6\u2858   \u2880\u2807  \u2878 \u2809\u2819\u2856\u2812  \u2502   Keepsakes                \u2502\r\n                  \u281e     \u28ff \u2830\u2803  \u28b0\u2801\u2809\u2832\u28c4 \u28