---
import courier from "../assets/orifude-courier-cutout.webp";
import courier255 from "../assets/orifude-courier-255.webp";
import { currentRelease } from "../data/releases";

const version = currentRelease.version;
---

<section class="opening" id="top" aria-labelledby="hero-title">
  <div class="opening__hero paper-fold">
    <div class="opening__copy">
      <h1 id="hero-title">Your letter will find someone you have never met.</h1>
      <p>
        With Orifude, you write a private, pseudonymous letter in your terminal,
        and the post office carries it to one unrelated person who may reply once.
      </p>
      <div class="hero__actions">
        <a class="primary-action" href="#download">Install {version}</a>
        <a class="text-action" href="#journey">See how it works</a>
      </div>
      <p class="alpha-note">Private alpha. Online identity creation is invite-only.</p>
    </div>
  </div>

  <div class="opening__terminal paper-fold">
    <div>
      <h2>See a complete exchange in the real TUI.</h2>
      <p>The recording uses a local demonstration post office and stores no real correspondence.</p>
    </div>
    <video
      controls
      preload="metadata"
      poster="/assets/terminal-demo-poster.webp"
      width="1200"
      height="720"
      aria-describedby="terminal-transcript"
    >
      <source src="/assets/terminal-demo.webm" type="video/webm" />
      Your browser cannot play the recording. The complete text transcript is
      available below.
    </video>
    <details class="transcript" id="terminal-transcript">
      <summary>Read the recording as text</summary>
      <ol>
        <li>Sora creates a local demonstration identity.</li>
        <li>Sora writes, previews, folds, and releases a letter.</li>
        <li>A waiting letter from Mori is claimed and explicitly unfolded.</li>
        <li>Sora sends the one allowed reply and keeps the exchange.</li>
      </ol>
    </details>
  </div>

  <img
    class="opening__courier"
    src={courier255.src}
    srcset={`${courier255.src} 255w, ${courier.src} 388w`}
    sizes="(max-width: 608px) 62vw, (max-width: 928px) 304px, 21vw"
    width="388"
    height="520"
    alt="A squirrel holding a folded letter on a branch"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
</section>

<section class="journey" id="journey" aria-labelledby="journey-title">
  <div class="journey__intro">
    <h2 id="journey-title">Your letter travels to one stranger and goes no farther.</h2>
    <p>
      You do not choose an audience or browse for a recipient. The post office
      quietly carries your words to one eligible person.
    </p>
  </div>
  <ol class="journey__steps">
    <li>
      <strong>You write a letter and let it go.</strong>
      <span>The TUI lets you read it once more before you release it.</span>
    </li>
    <li>
      <strong>The post office finds one stranger.</strong>
      <span>That person may claim your letter and choose to unfold it.</span>
    </li>
    <li>
      <strong>A single reply completes the exchange.</strong>
      <span>Either person can keep the finished correspondence privately.</span>
    </li>
  </ol>
</section>
