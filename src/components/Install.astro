---
import { installationInstructions, type Release, type Channel } from '../lib/releases';
import Arrow from './Arrow.astro';

interface Props { release?: Release; }
const { release } = Astro.props;
const labels: Record<Channel, string> = {
  posix: 'Linux & macOS · POSIX installer',
  powershell: 'Windows x86_64 · PowerShell',
  homebrew: 'macOS · Homebrew',
  scoop: 'Windows x86_64 · Scoop',
  aur: 'Arch Linux · orifude-bin',
};
---
<section id="get-orifude" class="get-paper wrap" aria-labelledby="get-title">
  <div class="get-intro">
    <span class="eyebrow">A paper of your own</span>
    <h2 id="get-title">{release ? 'Make yourself at home.' : 'Your next paper is on its way.'}</h2>
    <p>{release ? `Orifude ${release.version} is ready. Choose an installation method for your computer, then play entirely offline.` : 'The first release is being prepared. Until then, you can explore the code or build Orifude yourself.'}</p>
  </div>
  {release ? <div class="install-methods">
    <a class="text-link" href={release.url}>Release {release.version} and downloads <Arrow direction="out" /></a>
    {release.channels.map((channel) => <details>
      <summary>{labels[channel]} <span aria-hidden="true">+</span></summary>
      <div class="install-body">
        {(channel === 'posix' || channel === 'powershell') && <p>Download the installer first. After the download succeeds, inspect the file before running it. The next command creates a directory in your user account.</p>}
        {installationInstructions(release, channel).map((command, index) => <>
          {index > 0 && <p>{channel === 'aur' ? 'Inspect PKGBUILD before building and installing.' : 'After inspecting the downloaded file, run:'}</p>}
          <pre><code>{command}</code></pre>
        </>)}
        {(channel === 'posix' || channel === 'powershell') && <p>Add the destination to your PATH through your usual shell or system settings. The installer leaves your profile unchanged.</p>}
        {channel === 'powershell' && <p>The command allows the inspected script in its own PowerShell process without changing your saved execution policy.</p>}
        {channel === 'posix' && <p>For Linux kernel 5.10 or newer on x86_64 and ARM64, and macOS 13 or newer on Intel and Apple Silicon. Requires curl, tar, and sha256sum or shasum.</p>}
        {(channel === 'powershell' || channel === 'scoop') && <p>For Windows 10 22H2 or newer on x86_64. Windows ARM64 is not supported.</p>}
        {channel === 'homebrew' && <p>The formula supports macOS 13 or newer on Intel and Apple Silicon.</p>}
        {channel === 'aur' && <p>This package installs the verified x86_64 or ARM64 Linux binary. Review its source before allowing makepkg to install it.</p>}
      </div>
    </details>)}
    <details>
      <summary>Verify your download <span aria-hidden="true">+</span></summary>
      <div class="install-body">
        <p>GitHub CLI can verify the immutable release and an asset you downloaded. Replace the final filename with your local release asset.</p>
        <pre><code>{`gh release verify v${release.version} --repo nuggocto/orifude\ngh release verify-asset v${release.version} ./DOWNLOADED_ASSET --repo nuggocto/orifude`}</code></pre>
      </div>
    </details>
  </div> : <div class="get-actions">
    <a class="button button-dark" href="https://github.com/nuggocto/orifude#development">Build from source <Arrow direction="out" /></a>
    <a class="text-link" href="/changelog/">Follow the release notes <Arrow /></a>
    <p class="small-copy">The source is open. The game is yours to keep.</p>
  </div>}
</section>
