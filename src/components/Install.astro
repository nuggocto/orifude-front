---
import { installationInstructions, repository, type Release, type Channel } from '../lib/releases';
import Arrow from './Arrow.astro';
import Command from './Command.astro';

interface Props { release?: Release; }
const { release } = Astro.props;
const labels: Record<Channel, string> = {
  posix: 'Linux & macOS · POSIX installer',
  powershell: 'Windows · PowerShell',
  homebrew: 'macOS · Homebrew',
  scoop: 'Windows · Scoop',
  aur: 'Arch Linux · yay',
};
---
<div class="install-page wrap">
  <header class="install-heading">
    <span class="eyebrow">A paper of your own</span>
    <h1>Install Orifude.</h1>
    <p>{release ? `Orifude ${release.version} is ready. Choose one method below, copy the commands into your terminal, and open your first paper.` : 'The first release is being prepared. Until then, you can explore the code or build Orifude yourself.'}</p>
    {release && <a class="text-link" href={release.url}>Release {release.version} and downloads <Arrow direction="out" /></a>}
  </header>
  {release ? <>
    <nav class="install-index" aria-label="Installation methods">
      {release.channels.map((channel) => <a href={`#${channel}`}>{labels[channel]}</a>)}
    </nav>
    <div class="install-methods">
    {release.channels.map((channel) => <section class="install-method" id={channel} aria-labelledby={`${channel}-title`}>
      <h2 id={`${channel}-title`}>{labels[channel]}</h2>
      <div>
        {channel === 'posix' && <p>Copy this block into your terminal. It downloads the installer and installs Orifude in <code>~/.local/bin</code>.</p>}
        {channel === 'powershell' && <p>Copy this block into Windows PowerShell and press Enter. It installs Orifude in your user account. No administrator window is needed.</p>}
        {channel === 'homebrew' && <p>With Homebrew installed, run:</p>}
        {channel === 'scoop' && <p>With Scoop installed, add our bucket and install Orifude:</p>}
        {channel === 'aur' && <p>With yay installed, run this command. Review the AUR package when prompted.</p>}
        {installationInstructions(release, channel).map((command, index) =>
          <Command command={command} label={`${labels[channel]} command ${index + 1}`} />
        )}
        {channel === 'posix' && <p>Run <code>orifude</code> to play. If your shell cannot find it, run <code>~/.local/bin/orifude</code> and add <code>~/.local/bin</code> to PATH through your shell settings.</p>}
        {channel === 'powershell' && <>
          <p>Close and reopen your terminal, then run <code>orifude</code>. The installer adds <code>%LOCALAPPDATA%\Programs\Orifude</code> to your user PATH.</p>
        </>}
        {channel === 'posix' && <p>For Linux kernel 5.10 or newer on x86_64 and ARM64, and macOS 13 or newer on Intel and Apple Silicon. Requires curl, tar, and sha256sum or shasum.</p>}
        {(channel === 'powershell' || channel === 'scoop') && <p>For Windows 10 22H2 or newer on x86_64. Windows ARM64 is not supported.</p>}
        {channel === 'homebrew' && <p>The formula supports macOS 13 or newer on Intel and Apple Silicon.</p>}
        {channel === 'aur' && <p>The orifude-bin package installs the verified Linux binary for x86_64 or ARM64.</p>}
      </div>
    </section>)}
    <section class="install-method" aria-labelledby="play-title">
      <h2 id="play-title">Open your first paper.</h2>
      <p>Once Orifude is on your PATH, open a terminal with at least 80 columns and 24 rows, then run:</p>
      <Command command="orifude" label="launch command" />
      <p>Use your keyboard to play. Your progress stays on your computer, and the game works entirely offline.</p>
    </section>
    <details>
      <summary>Verify your download <span aria-hidden="true">+</span></summary>
      <div class="install-body">
        <p>The commands trust the installer from the exact GitHub release over HTTPS. Each installer checks the downloaded archive against its embedded SHA-256 before replacing Orifude.</p>
        <p>To inspect the script first or choose a custom directory, follow the <a href={`${repository}/blob/shrek/docs/distribution.md#installing-an-exact-published-version`}>installation guide</a>. Download the <a href={`${repository}/releases/download/v${release.version}/install.sh`}>POSIX script</a> or <a href={`${repository}/releases/download/v${release.version}/install.ps1`}>PowerShell script</a> for inspection.</p>
        {release.powershellSha256 && <p>The reviewed PowerShell script SHA-256 is <code>{release.powershellSha256}</code>.</p>}
        <p>GitHub CLI can verify the immutable release and an asset you downloaded. Replace the final filename with your local release asset.</p>
        <Command command={`gh release verify v${release.version} --repo nuggocto/orifude\ngh release verify-asset v${release.version} ./DOWNLOADED_ASSET --repo nuggocto/orifude`} label="download verification commands" />
      </div>
    </details>
    </div>
  </> : <div class="get-actions">
    <a class="button button-dark" href="https://github.com/nuggocto/orifude#development">Build from source <Arrow direction="out" /></a>
    <a class="text-link" href="/changelog/">Follow the release notes <Arrow /></a>
    <p class="small-copy">The source is open. The game is yours to keep.</p>
  </div>}
</div>
