---
import CopyableCode from "./CopyableCode.astro";
import { currentRelease, platformNames } from "../data/releases";

const systems = ["linux", "darwin", "windows"] as const;

const packageCommands = [
  {
    label: "Homebrew on macOS or Linux",
    command: "brew install nuggocto/tap/orifude",
  },
  {
    label: "Scoop on Windows",
    command:
      "scoop bucket add nuggocto https://github.com/nuggocto/scoop-bucket\nscoop install nuggocto/orifude",
  },
  {
    label: "AUR on Arch Linux",
    command: "paru -S orifude-bin",
  },
] as const;

const posixInstaller = `curl -fsSLo install-orifude.sh https://orifude.com/install.sh
less install-orifude.sh
sh install-orifude.sh --version 0.2.0`;

const powershellInstaller = `Invoke-WebRequest https://orifude.com/install.ps1 -OutFile install-orifude.ps1
Get-Content .\\install-orifude.ps1
.\\install-orifude.ps1 -Version 0.2.0`;
---

<section class="downloads" id="download" aria-labelledby="download-title">
  <div class="downloads__intro">
    <h2 id="download-title">Install Orifude on your computer.</h2>
    <p>
      Orifude {currentRelease.version} ships for Linux, macOS, and Windows on
      amd64 and arm64. Start with a package manager, or use a verified installer
      if you prefer to inspect every step.
    </p>
  </div>

  <div class="install-paths" aria-labelledby="install-title">
    <div class="install-paths__intro">
      <h3 id="install-title">Start with your package manager.</h3>
    </div>

    <div class="install-command">
      <h4>Choose the command for your system.</h4>
      <div class="package-commands">
        {
          packageCommands.map(({ label, command }) => (
            <section class="package-command" aria-label={label}>
              <h5>{label}</h5>
              <CopyableCode label={`${label} command`} value={command} />
            </section>
          ))
        }
      </div>
    </div>

    <div class="install-options">
      <details>
        <summary>Use the verified POSIX shell installer.</summary>
        <CopyableCode
          label="verified POSIX shell installer commands"
          value={posixInstaller}
        />
      </details>

      <details>
        <summary>Use the verified PowerShell installer.</summary>
        <CopyableCode
          label="verified PowerShell installer commands"
          value={powershellInstaller}
        />
      </details>

      <p>
        Homebrew, Scoop, and the AUR install the same published release and
        verify the archive selected for your machine.
      </p>
    </div>
  </div>

  <div class="archive-intro">
    <h3>
      <span>Download and verify the</span>
      <span>release archive yourself.</span>
    </h3>
    <p>
      Every archive below is immutable. Compare its SHA-256 value with the
      published checksum file before you install it.
    </p>
  </div>

  {
    currentRelease.status === "preparing" ? (
      <p class="release-pending" role="status">
        The release is being prepared. Downloads appear only after all six
        archives and their checksums are verified.
      </p>
    ) : (
      <>
        <div class="artifact-groups">
          {systems.map((os) => (
            <section class="artifact-group" aria-labelledby={`platform-${os}`}>
              <h3 id={`platform-${os}`}>{platformNames[os]}</h3>
              <ul>
                {currentRelease.artifacts
                  .filter((artifact) => artifact.os === os)
                  .map((artifact) => (
                    <li>
                      <a href={artifact.url}>
                        <span>{artifact.arch}</span>
                        <span>{artifact.format}</span>
                      </a>
                      <CopyableCode
                        compact
                        label={`${platformNames[os]} ${artifact.arch} SHA-256 checksum`}
                        value={artifact.sha256}
                      />
                    </li>
                  ))}
              </ul>
            </section>
          ))}
        </div>

        <a class="checksum-link" href={currentRelease.checksumURL}>
          Complete SHA-256 checksum file
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 17 17 7M8 7h9v9"></path>
          </svg>
        </a>
      </>
    )
  }

</section>

<script is:inline src="/scripts/copy-code.js"></script>
