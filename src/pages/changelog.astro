---
import Hero from "../components/Hero.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { changelogReleases } from "../data/changelog";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Changelog · Orifude";
const description = "Read what changed in each published Orifude release.";
---

<BaseLayout {title} {description}>
  <div class="site-shell">
    <Hero current="changelog" />
    <main class="changelog-page" id="main-content">
      <header class="changelog-intro paper-fold">
        <h1>What has changed in Orifude.</h1>
        <p>
          Every published release is recorded here. These notes match the
          changelog kept with the source.
        </p>
      </header>

      <div class="changelog-releases">
        {
          changelogReleases.map((release) => (
            <article class="release-note" aria-labelledby={`release-${release.version}`}>
              <header class="release-note__header">
                <div>
                  <h2 id={`release-${release.version}`}>{release.version}</h2>
                  <time datetime={release.publishedAt}>{release.publishedLabel}</time>
                </div>
                <a href={release.releaseURL}>Open this release on GitHub</a>
              </header>

              <div class="release-note__changes">
                {release.groups.map((group) => (
                  <section aria-labelledby={`release-${release.version}-${group.title.toLowerCase()}`}>
                    <h3 id={`release-${release.version}-${group.title.toLowerCase()}`}>
                      {group.title}
                    </h3>
                    <ul>
                      {group.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
