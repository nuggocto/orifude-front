---
import BaseLayout from "../layouts/BaseLayout.astro";
import Downloads from "../components/Downloads.astro";
import Faq from "../components/Faq.astro";
import Hero from "../components/Hero.astro";
import OpeningScene from "../components/OpeningScene.astro";
import Principles from "../components/Principles.astro";
import PrivacySafety from "../components/PrivacySafety.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = "Orifude · A private letter exchange for your terminal";
const description =
  "A one-to-one terminal letter exchange. Write once, fold it, and let the post office carry it to one unrelated stranger.";
---

<BaseLayout {title} {description}>
  <div class="site-shell">
    <Hero />
    <main id="main-content">
      <OpeningScene />
      <Principles />
      <PrivacySafety />
      <Downloads />
      <Faq />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
