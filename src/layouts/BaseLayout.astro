---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f3efe8" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/assets/orifude-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Orifude" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://orifude.com/assets/social-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Orifude folded-leaf wordmark" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://orifude.com/assets/social-card.png" />
    <title>{title}</title>
  </head>
  <body>
    <!--
      THESIS: A folded letter and its courier make the private exchange tangible; the page refuses slogan stacks, card grids, and product chrome.
      OWN-WORLD: Warm paper, charcoal ink, muted moss, generous space, readable literary type, and the supplied courier with no glows or ornamental branch across content.
      STORY: Understand the one-to-one exchange, watch the real terminal journey, learn the privacy boundary, then install and verify the release.
      FIRST VIEWPORT: Two quiet folded sheets hold the promise and real TUI proof; the courier rests between them without crossing text or video controls.
      FORM: Simplified folded letter, restored at the user's direction from seed 611667c2; reference .impeccable/mocks/folded-branch-approved.png.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <a class="skip-link" href="#main-content">Skip to the letter</a>
    <slot />
  </body>
</html>
