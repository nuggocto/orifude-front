{
  "name": "orifude-front",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && node --test tests/*.test.mjs",
    "build": "astro build && node scripts/check-build.mjs",
    "preview": "node scripts/preview.mjs",
    "test:browser": "playwright test",
    "import:changelog": "node scripts/import-changelog.mjs"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "astro": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "sharp": "0.35.4",
    "typescript": "6.0.3"
  }
}
