{
  "name": "orifude-front",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm validate:releases && astro check && astro build",
    "preview": "astro preview",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "validate:releases": "node --experimental-strip-types src/data/releases.test.ts",
    "check": "pnpm fmt:check && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/alegreya": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "astro": "7.2.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.3.0"
}
